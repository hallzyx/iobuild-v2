# Frontend environment variables — copy to .env and fill secrets
# All VITE_* vars are exposed to the client bundle at build time.

# Core API
VITE_API_URL=/api/v1
VITE_USERS_ENDPOINT_PATH=/users
VITE_IAM_SESSIONS_PATH=/sessions
VITE_PLANS_ENDPOINT_PATH=/plans
VITE_UNITS_ENDPOINT_PATH=/units
VITE_CLIENTS_ENDPOINT_PATH=/clients
VITE_DEVICES_ENDPOINT_PATH=/devices
VITE_ANALYTICS_ENDPOINT_PATH=/analytics
VITE_PROFILES_ENDPOINT_PATH=/profiles
VITE_SUBSCRIPTIONS_ENDPOINT_PATH=/subscriptions
VITE_PROJECTS_ENDPOINT_PATH=/projects

# Dev proxy / app URL
VITE_PROXY_TARGET=http://localhost:8080
VITE_APP_URL=http://localhost:5173

# Third-party
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_WIDGET_URL=https://widget.cloudinary.com/v2.0/global/all.js
VITE_STRIPE_PUBLISHABLE_KEY=

# Analytics / polling
VITE_ANALYTICS_DEFAULT_MINUTES=10
VITE_POLLING_INTERVAL_MS=30000
